header data-turbo-permanent="true" id="main-header"
  nav.navbar.navbar-light.navbar-expand-lg.navbar-fixed.top role="navigation"
    .container
      = link_to root_path, class: 'navbar-brand' do
        = image_tag 'logo-hf.png'
        = image_tag 'logo-text.png'

      button.navbar-toggler type="button" data-bs-toggle="collapse" data-bs-target="#navbar-nav" aria-controls="navbar-nav" aria-expanded="false" aria-label="Toggle navigation"
        span.navbar-toggler-icon

      .collapse.navbar-collapse#navbar-nav
        ul.nav.navbar-nav.ml-auto
          - if user_signed_in?
            - if current_user.has_role?("administrator")
              - flags_count = Flag.unresolved.count
              li.dropdown.nav-item id="admin-menu-item"
                a.nav-link.dropdown-toggle data-bs-toggle='dropdown' href="#"
                  span.badge.badge-danger id="admin-badge-top" style="#{flags_count > 0 ? '' : 'display: none;'}"
                    = flags_count
                  = ' ' if flags_count > 0
                  | Admin
                .dropdown-menu.two-column-dropdown
                  .row.row-cols-1.row-cols-lg-2.g-0
                    .col
                      = link_to flags_path, class: 'dropdown-item' do
                        | Flagged Content &nbsp;
                        span.badge.badge-danger id="admin-badge-menu" style="#{flags_count > 0 ? '' : 'display: none;'}"
                          = flags_count
                      = link_to 'CMS Pages', cms_pages_path, class: 'dropdown-item'
                      = link_to 'Controlled Vocabularies', vocabularies_path, class: 'dropdown-item'
                      = link_to 'Documents', documents_path, class: 'dropdown-item'
                      = link_to 'Map Overlays', map_overlays_path, class: 'dropdown-item'
                      = link_to 'Narratives', narratives_path, class: 'dropdown-item'
                      = link_to 'Person Records', people_path, class: 'dropdown-item'
                      = cms_link
                    .col
                      = link_to 'Localities', localities_path, class: 'dropdown-item'
                      = link_to 'Census Coverage', census_coverages_path, class: 'dropdown-item'
                      = link_to 'Statistics', stats_path, class: 'dropdown-item'
                      = link_to 'Volunteer Applications', volunteer_applications_path, class: 'dropdown-item'
                      = link_to 'Users', users_path, class: 'dropdown-item'
                      = link_to 'User Groups', user_groups_path, class: 'dropdown-item'
                      = link_to 'Street Conversions', street_conversions_path, class: 'dropdown-item'
                      = link_to 'Settings', settings_path, class: 'dropdown-item'
                      = link_to 'Rebuild Index', rebuild_index_path, class: 'dropdown-item', data: { turbo_method: :post }

            - elsif current_user.has_role?("editor")
              - flags_count = Flag.unresolved.count
              li.nav-item id="editor-menu-item"
                = link_to flags_path, class: 'nav-link' do
                  | Flagged Content &nbsp;
                  span.badge.badge-danger id="editor-badge" style="#{flags_count > 0 ? '' : 'display: none;'}"
                    = flags_count

          - localities = Locality.all
          - summary_return_path = summary_locality_return_path if respond_to?(:summary_locality_return_path)
          - locality_return = { return_to: summary_return_path }.compact
          - active_locality = summary_return_path ? summary_locality_id : Current.locality_id
          - if localities.length > 1
            li.nav-item.dropdown
              a.dropdown-toggle.nav-link data-bs-toggle="dropdown" href="#"
                - if active_locality
                  = localities.detect { |item| item.id == active_locality }.short_name
                - else
                  | Localities
              .dropdown-menu
                - if active_locality || summary_return_path
                  = link_to 'Show All', reset_localities_path(locality_return), data: { turbo_method: :put }, class: 'dropdown-item'
                - localities.each do |row|
                  - next if row.id == active_locality
                  = link_to row.short_name, set_locality_path(row, locality_return), data: { turbo_method: :put }, class: 'dropdown-item'

          li.nav-item= link_to 'The Forge', forge_path, class: 'nav-link'
          li.nav-item.dropdown
            a.nav-link.dropdown-toggle data-bs-toggle='dropdown' href="#"
              | Data
            .dropdown-menu.dropdown-menu-lg-end.two-column-dropdown
              .row.row-cols-1.row-cols-lg-2.g-0
                .col
                  - CensusYears.each_visible_to_user(user_signed_in?) do |year|
                    = link_to "#{year} US Census", census_records_path(year: year), class: 'dropdown-item'
                  - summary_year = CensusYears.visible_to_user(current_user).reverse.find { |year| can_view_census_summary?(year) }
                  - if summary_year
                    = link_to 'Census Summaries', census_summary_path(year: summary_year, facet: 'race'), class: 'dropdown-item'
                .col
                  = link_to 'Buildings', buildings_path, class: 'dropdown-item'
                  = link_to 'All People', people_path, class: 'dropdown-item' if can_people?
                  = link_to AppConfig[:document_page_title] || 'Resources & Credits', documents_path, class: 'dropdown-item'
                  = link_to "Photographs", photographs_path, class: 'dropdown-item'
                  = link_to 'Audio Recordings', audios_path, class: 'dropdown-item'
                  = link_to 'Videos', videos_path, class: 'dropdown-item'

          - if my_stuff_available?
            li.nav-item.dropdown id="my-menu-item"
              a.nav-link.dropdown-toggle data-bs-toggle="dropdown" href="#" My
              .dropdown-menu
                = link_to 'My stuff', my_stuff_users_path, class: 'dropdown-item'
                - if can?(:search_by_creator, CensusRecord)
                  = link_to 'Operator census activity', operator_census_activity_path, class: 'dropdown-item'
                .dropdown-divider
                = render 'users/my_search_links', link_class: 'dropdown-item'

          li.nav-item.dropdown
            a.dropdown-toggle.nav-link data-bs-toggle="dropdown" href="#" More
            .dropdown-menu
              = link_to 'About', 'https://historyforge.net', target: '_blank', class: 'dropdown-item'
              = link_to 'Contact', contact_path, class: 'dropdown-item'
              = link_to 'Volunteer', "#{root_path}volunteer", class: 'dropdown-item'
          - if user_signed_in?
            li.nav-item.dropstart id="user-menu-item"
              a.nav-link.dropdown-toggle data-bs-toggle='dropdown' href="#"
                i.fa.fa-user
              .dropdown-menu
                .dropdown-item-text id="user-name"= current_user.name
                = link_to 'My profile', user_path(current_user), class: 'dropdown-item'
                = link_to 'Edit my account', edit_user_path(current_user), class: 'dropdown-item'
                = link_to 'Passkeys', users_passkeys_path, class: 'dropdown-item'
                = link_to "Log out", destroy_user_session_path, method: :delete, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'dropdown-item'
          - else
            li.nav-item id="login-menu-item"
              = link_to 'Log in', new_user_session_path, class: 'nav-link'

