<% if bot? %>
  <% nearby_buildings = @building.neighbors.includes(:addresses).limit(5) %>
  <% if nearby_buildings.any? %>
    <div id="building-list">
      <h3>Nearby Buildings</h3>
      <div class="list-group">
        <% nearby_buildings.each do |building| %>
          <div class="list-group-item building">
            <p>
              <%= link_to building.street_address, building_path(building), title: "Open building record" %>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <% initial_state = {
    layers: { center: { lat: @building.lat&.to_f, lng: @building.lon&.to_f }, layers: mini_forge_layers.as_json },
    buildings: { buildings: mini_forge_buildings.as_json, current: @building.as_json, editable: can?(:update, @building) },
    search: { params: params }
  } %>
  <%= tag.div id: 'miniforge', data: { initial_state: initial_state } %>
<% end %>
