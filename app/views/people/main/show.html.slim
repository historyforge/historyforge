- set_page_title @person_representation.name
- content_for :head do
  link rel="canonical" href=@person_representation.canonical_url
- unless user_signed_in?
  - if (description = @person_representation.description)
    - content_for :meta_description do
      meta name="description" content=String.new(description)
  script type="application/ld+json"
    == ERB::Util.json_escape(PersonJsonLdSerializer.new(@person_representation).to_json)
= render 'shared/flag_resolution', item: @person
- btn_class = 'btn btn-sm btn-secondary'
- if user_signed_in?
  .mb-3.person-actions.d-flex.flex-wrap.gap-2
    - if can_people? || can?(:read, Person)
      = link_to 'View All', people_path, class: btn_class
    - if can?(:create, Flag)
      = render 'shared/flag_it', item: @person, item_class: btn_class
    - if can?(:update, @person)
      = link_to [:edit, @person], class: btn_class do
        i.fa.fa-pencil
        span.d-none.d-lg-inline
          | &nbsp; Edit
    = render 'merge_modal', btn_class:
    - if can?(:destroy, @person) && @person.census_records.blank?
      = link_to @person, method: :delete, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: btn_class do
        i.fa.fa-trash
        span.d-none.d-lg-inline
          | &nbsp; Delete
    - if [Photograph, Audio, Video].any? { |type| can?(:create, type) }
      = render 'media/add_menu', item: @person, button_class: btn_class
    - if can?(:create, Narrative)
      = link_to 'Add Source/Narrative', new_person_narrative_path(@person), class: btn_class
- elsif can_people? || can?(:read, Person)
  - content_for :pills do
    .text-right
      = link_to 'View All', people_path, class: 'btn btn-light'
- if @navigation_neighbors.present?
  - if @navigation_neighbors[:previous_id]
    = previous_nav_link(person_path(@navigation_neighbors[:previous_id], navigation: @navigation_context))
  - if @navigation_neighbors[:next_id]
    = next_nav_link(person_path(@navigation_neighbors[:next_id], navigation: @navigation_context))

- summary = @person_representation.summary
- has_biography = summary || @person.description.present?
.row.person-section
  - if has_biography
    section.person-biography.col-lg-8.mb-3.mb-lg-0 aria-label="Biography"
      - if summary
        - summary.split("\n\n").each do |paragraph|
          p.mt-0.mb-2= paragraph
        p.small.mt-0.mb-0
          ' Census sources:
          = safe_join(@person_representation.summary_source_links.map { |source| link_to(source[:label], source[:url]) }, ', ')
      - if @person.description.present?
        .person-description class=("mt-2" if summary)
          = auto_link(simple_format(@person.description), html: { target: '_blank', rel: 'nofollow' })
  .col-lg-4
    .card.p-2
      table.table.table-sm.table-borderless.mb-0 aria-label="Person details"
        tbody
          - names = @person_representation.alternate_names
          - if names.any?
            tr
              th scope="row" Also recorded as
              td= names.join(', ')
          - if @person.birth_year
            tr
              th scope="row" Born
              td= "#{'About ' if @person.is_birth_year_estimated?}#{@person.birth_year}"
          - if @person.death_year
            tr
              th scope="row" Died
              td= "#{'About ' if @person.is_death_year_estimated?}#{@person.death_year}"
          - if @person.race.present? && @person.race != 'on'
            tr
              th scope="row" Race
              td= Translator.option(:race, @person.race)
          - if @person.sex.present? && @person.sex != 'on'
            tr
              th scope="row" Sex
              td= Translator.option(:sex, @person.sex)
          tr
            th scope="row" Person ID
            td= @person.id

- photos = @person.photos.in_chronological_order.accessible_by(current_ability).to_a
- audios = @person.audios.in_chronological_order.accessible_by(current_ability).to_a
- videos = @person.videos.in_chronological_order.accessible_by(current_ability).to_a
- narratives = @person.narratives.accessible_by(current_ability).with_all_rich_text.to_a
- if @visible_census_records.any?
  section.person-census.person-section aria-labelledby="person-census-heading" data-controller=("census-view" if @visible_census_records.many?)
    .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-3
      h2#person-census-heading.h4.mb-0= @visible_census_records.one? ? 'Census appearance' : 'Life in the census'
      - if @visible_census_records.many?
        .btn-group.btn-group-sm role="group" aria-label="Census record view" class="d-none" data-target="census-view.controls"
          button.btn.btn-outline-secondary.active type="button" aria-pressed="true" aria-controls="person-census-cards" data-target="census-view.cardsButton" data-action="census-view#showCards" Cards
          button.btn.btn-outline-secondary type="button" aria-pressed="false" aria-controls="person-census-table" data-target="census-view.tableButton" data-action="census-view#showTable" Table
    #person-census-cards data-target="census-view.cards"
      = render 'census_appearances', records: @visible_census_records, households: @visible_census_households
    - if @visible_census_records.many?
      #person-census-table hidden=true data-target="census-view.table"
        = render 'census_comparison', records: @visible_census_records

.person-associated-content
  = render 'media/display_on_associated_record', item: @person, photos:, audios:, videos:, compact: true
  = render 'associated_narratives', narratives:

- if can?(:update, @person) && @person.possible_unmatched_records.present?
  .card.mb-3
    .card-header Possible Census Records
    = table do
      thead
        tr
          th Year
          th Name
          th
            | Relation
            span.d-none.d-lg-inline &nbsp;to Head
          th Address
          th Age
          th Race
          th POB
          th Marriage
          th Occupation
          th
      tbody
        - @person.possible_unmatched_records.each do |row|
          tr
            td= row.year
            td.text-nowrap= link_to row.name, row
            td= row.relation_to_head if row.year >= 1880
            td.text-nowrap= row.street_address
            td= row.age
            td= row.race
            td= row.pob
            td= row.marital_status if row.year >= 1880
            td= row.occupation
            td
              = form_for row do |form|
                = hidden_field_tag 'census_record[person_id]', @person.id
                = hidden_field_tag 'context', 'person'
                = form.submit 'Match!', class: 'btn btn-sm btn-secondary'

- if @person.notes? && can?(:update, @person)
  .card.mb-3
    .card-header
      | Additional Notes
    .card-body
      = simple_format @person.notes

- if can?(:update, @person)
  = render 'shared/change_history', item: @person
