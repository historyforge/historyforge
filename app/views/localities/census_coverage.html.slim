- set_page_title "Census Coverage for #{@locality.name}"
- content_for :pills do
  = link_to 'All coverage targets', census_coverages_path, class: 'btn btn-light btn-xs'
  = link_to 'Statistics', stats_path(locality_id: @locality.id), class: 'btn btn-light btn-xs'

.row.g-4
  aside.col-md-4.col-lg-3
    nav aria-label="Census years"
      .list-group
        - CensusYears.each do |year|
          - target = @coverages_by_year[year]
          - selected = year == @coverage.census_year
          = link_to census_coverage_locality_path(@locality, year:),
                    class: ['list-group-item', 'list-group-item-action', 'd-flex', 'justify-content-between', 'align-items-center', ('active' if selected)],
                    aria: { current: ('page' if selected) } do
            strong= year
            span.small.opacity-75= target ? "#{number_with_delimiter(target.expected_records)} expected" : 'Target unset'
  .col-md-8.col-lg-7
    .card
      .card-body.p-3.p-lg-4
        h2.h4.mb-3= "#{@coverage.census_year} census target"
        = simple_form_for @coverage, url: update_census_coverage_locality_path(@locality, year: @coverage.census_year), method: :patch do |form|
          .row.g-3
            .col-sm-5
              = form.input :expected_records, label: 'Expected census records', input_html: { min: 1 }
            .col-sm-7
              fieldset.mb-3
                legend.form-label.fs-6 How did you get this count?
                - CensusCoverage::TARGET_BASES.each do |basis|
                  .form-check
                    = form.radio_button :target_basis, basis, class: 'form-check-input', required: true
                    = form.label :target_basis, basis, value: basis, class: 'form-check-label'
                = form.error :target_basis
          = form.input :source, as: :text, label: 'Where can someone verify this count?',
                       hint: 'Enter a link, report and table number, or an explanation of the estimate.',
                       input_html: { rows: 2 }
          = form.input :scope_note, label: 'Which area does the count cover? (optional)',
                       hint: 'Note any exclusions, such as a village tracked separately.',
                       input_html: { rows: 2 }
          fieldset.border-top.pt-3.mt-3
            legend.float-none.w-auto.fs-6.fw-semibold Transcription verification
            .form-check.mb-2
              = hidden_field_tag 'census_coverage[verified_complete]', '0', id: nil
              = check_box_tag 'census_coverage[verified_complete]', '1', @coverage.verified_complete?, id: 'census_coverage_verified_complete', class: 'form-check-input'
              = label_tag 'census_coverage_verified_complete', 'Transcription verified complete', class: 'form-check-label'
            p.small.text-muted Check this after verifying that all intended census schedules were transcribed.
            = form.input :verification_note, label: 'Verification note',
                         hint: 'Required when marking complete. Describe what you checked and explain any known difference from the target.',
                         required: false, input_html: { rows: 2 }
            - if @coverage.verified_at_in_database
              p.small.text-muted
                | Verified on #{l(@coverage.verified_at_in_database.to_date, format: :long)}
                - if @coverage.verified_by
                  |  by #{@coverage.verified_by.login}
                | .
          = form.submit 'Save target', class: 'btn btn-primary', data: { turbo_submits_with: 'Saving…' }
        - if @coverage.persisted?
          .border-top.mt-4.pt-3
            = button_to 'Remove target', remove_census_coverage_locality_path(@locality, year: @coverage.census_year),
                        method: :delete, class: 'btn btn-outline-danger btn-sm',
                        form: { data: { turbo_confirm: "Remove the #{@coverage.census_year} coverage target?" } }
