- @recent_creations.each do |record|
  - case record
  - when Building
    - label = record.primary_street_address
    - path = building_path(record)
    - record_type = 'Building'
  - when Person
    - label = record.name
    - path = person_path(record)
    - record_type = 'Person'
  - when CensusRecord
    - label = record.name
    - path = census_record_path(year: record.year, id: record.id)
    - record_type = "#{record.year} US Census"
  li.list-group-item id=dom_id(record)
    = link_to label.presence || "Record ##{record.id}", path
    .small.text-muted
      = "#{record_type} · #{l(record.created_at.to_date, format: :long)}"
