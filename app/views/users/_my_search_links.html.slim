- filters = { operator_id: current_user.id }
- if operator_search_scope(Building)
  = link_to 'My buildings', buildings_path(s: filters), class: link_class
- if operator_search_scope(Person) && can_people?
  = link_to 'My people records', people_path(s: filters), class: link_class
- if operator_search_scope(CensusRecord)
  - CensusYears.each_visible_to_user(true) do |year|
    = link_to "My #{year} US Census records", census_records_path(year:, s: filters), class: link_class
