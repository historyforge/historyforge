- set_page_title "Connect user for #{@application.name}"
p
  strong Email: 
  = @application.email
- if @user.errors.any?
  .alert.alert-danger role="alert"
    ul
      - @user.errors.full_messages.each do |message|
        li= message
- if @matching_users.any?
  p An account already uses this email. Review it before connecting this volunteer. Linking an account does not send an invitation or change its permissions.
  - @matching_users.each do |user|
    .card.mb-3
      .card-body
        h2.h5= link_to user.login, user_path(user)
        p= user.enabled? ? 'Enabled account' : 'Disabled or awaiting invitation acceptance'
        = button_to 'Link existing user', volunteer_application_account_path(@application), params: { volunteer_account: { user_id: user.id } }, class: 'btn btn-primary'
- else
  p Create a user and send an invitation to set their password. Choose a group if needed; no roles are granted by default.
  = simple_form_for @user, as: :volunteer_account, url: volunteer_application_account_path(@application) do |form|
    = form.input :login, label: 'Username'
    = form.input :user_group_id, label: 'Group', collection: UserGroup.order(:name), include_blank: true
    = form.submit 'Create user and send invitation', class: 'btn btn-primary'
= link_to 'Back to applications', volunteer_applications_path, class: 'd-block mt-3'
