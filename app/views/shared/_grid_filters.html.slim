- content_for :pills do
  - if can?(:create, resource_class)
    = link_to 'Add New Record', [:new, resource_class.model_name.singular_route_key.to_sym], class: 'btn btn-sm btn-light'
  - if can?(:bulk_update, resource_class) && controller.respond_to?(:year)
    = link_to 'Bulk Update', "/census/#{controller.year}/bulk", class: 'btn btn-sm btn-light'
  - if can?(:review, resource_class) && controller.respond_to?(:year) && @search.census_scope_search?
    - count = @search.scoped.unreviewed.count
    - if count > 0
      = link_to "Mark #{count} Reviewed", request.params.merge(action: :bulk_review, from: 1, to: 100), class: 'btn btn-sm btn-light', data: { remote: false, turbo_method: :post, turbo_confirm: "Are you sure? Undoing this action may be painful." }
    - count = @search.scoped.unmatched.count
    - if count > 0
      = link_to "Make #{count} Persons", request.params.merge(action: :bulk_person_match, from: 1, to: 100), class: 'btn btn-sm btn-light', data: { remote: false, turbo_method: :post, turbo_confirm: "Are you sure? Undoing this action may be painful." }

  - if @search.active?
    = link_to 'Start New Search', url_for(reset: true), class: 'btn btn-sm btn-light'
  .dropdown.ml-2 data-controller="load-saved-search"
    a.dropdown-toggle.btn.btn-sm.btn-light data-toggle="dropdown" Load Search
    .dropdown-menu

- operator_filters = @search.operator_filters
- operator_picker = { controller: 'operator-picker' } if @search.operator_scope == :all
= simple_form_for @search, url: url_for(), method: :get, as: :s, html: { data: operator_picker } do |form|
  - if @search.operator_scope
    = hidden_field_tag 's[operator_id]', operator_filters[:operator_id], data: { target: 'operator-picker.id' }
  .float-right
    = form.submit 'Submit', style: 'display: none'
    => link_to 'CSV', request.params.merge(format: :csv), class: 'btn btn-sm btn-primary'
    - if controller.respond_to?(:year)
      => form.submit 'Map It', class: 'btn btn-sm btn-primary', id: 'search-map', data: {year: controller.year}
      - if can_demographics?(controller.year)
        => link_to 'Demographics', send("demographics_census#{year}_records_path", facet: 'race'), class: 'btn btn-sm btn-primary'
    - elsif params[:controller] == 'buildings/main'
      => form.submit 'Map It', class: 'btn btn-sm btn-primary', id: 'search-map'
    - if @search.active?
      button.btn.btn-sm.btn-primary type="button" data-controller="save-search" Save It
  .mb-3
    button.btn.btn-sm.btn-light type="button" data-toggle="collapse" data-target="#fieldSelector" = pluralize @search.columns.size, 'Field'
    button.btn.btn-sm.btn-light.mr-3 type="button" data-toggle="collapse" data-target="#newAttributeFilter" Filter

  = yield :filter_buttons

  #attribute-filters

  .collapse.fade#fieldSelector
    .card.mb-3
      .card-header
        button.float-right.close(type="button" data-toggle="collapse" data-target="#fieldSelector") &times;
        span Fields

      .card-body
        .column-count-2.checkboxes#fields
          - @search.all_fields.each do |field|
            label.dropdown-item.checkbox for="f_#{field}"
              = check_box_tag 'f[]', field, @search.f.include?(field), id: "f_#{field}", data: { default: @search.default_field?(field) }
              = translated_label resource_class, field
      .card-footer
        = form.submit 'Submit', data: { turbo_submits_with: 'Sending...' }, class: 'btn btn-primary mr-auto'
        button.btn.btn-light.ml-auto.checkall data-scope="#fields" type="button" Check all

  .collapse.fade#newAttributeFilter class=('show' if @search.operator_filter_active?)
    .card.mb-3
      .card-header
        button.float-right.close(type="button" data-toggle="collapse" data-target="#newAttributeFilter") &times;
        span Search Filters
      .card-body
        - if @search.operator_scope
          .form-row
            .form-group.col-md-4
              - if @search.operator_scope == :all
                = label_tag 'operator_lookup', 'Created by'
                = search_field_tag 'operator_lookup', @search.selected_operator_name, name: nil, placeholder: 'Search by name or email', autocomplete: 'off', class: 'form-control mb-2', data: { target: 'operator-picker.lookup', action: 'input->operator-picker#clearSelection', url: operator_autocomplete_users_path(format: :json) }
            .form-group.col-md-4
              = label_tag 's_operator_created_from', 'Created from'
              = date_field_tag 's[operator_created_from]', operator_filters[:operator_created_from], class: 'form-control'
            .form-group.col-md-4
              = label_tag 's_operator_created_to', 'Created through'
              = date_field_tag 's[operator_created_to]', operator_filters[:operator_created_to], class: 'form-control'
          p.form-text.text-muted Select a creator to filter by creation date.
          hr

        - if controller.respond_to?(:year) && user_signed_in?
          .row
            - if controller.year >= 1880
              .col-3
                label for="s_ward_eq"= translated_label(resource_class, :ward)
                input.form-control#s_ward_eq type="search" name="s[ward_eq]" value=@search.s[:ward_eq]
              .col-3
                label for="s_enum_dist_eq"= translated_label(resource_class, :enum_dist)
                input.form-control#s_enum_dist_eq type="search" name="s[enum_dist_eq]" value=@search.s[:enum_dist_eq]
            .col-3
              label for="s_page_number_eq"= translated_label(resource_class, :page_number)
              input.form-control#s_page_number_eq type="number" name="s[page_number_eq]" value=@search.s[:page_number_eq] min="1" max=CensusRecordSearch::PAGE_NUMBER_MAX
            - if controller.year < 1950 and controller.year >= 1880
              .col-3
                label for="s_page_side_eq"= translated_label(resource_class, :page_side)
                = select_tag 's[page_side_eq]', options_for_select(resource_class.page_side_choices, @search.s[:page_side_eq]), include_blank: true, class: 'form-control'
          hr

        .row
          .col-3
            select.attribute.form-control
          .scope-selection-container.col-3
          .value-input-container.col-6
      .card-footer
        = form.submit 'Submit', data: { turbo_submits_with: 'Sending...' }, class: 'btn btn-primary'
