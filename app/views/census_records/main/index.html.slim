- set_page_title "#{controller.year} U.S. Census"
- if current_user
  - content_for :filter_buttons do
    .btn-group.btn-group-toggle data-controller="search-scope" data-action="change->search-scope#submit"
      = checkbox_button 'All', 'on', @search.scope.blank?
      = checkbox_button 'No Building', :unhoused, @search.unhoused?
      = checkbox_button 'Not Reviewed', :unreviewed, @search.unreviewed?
      = checkbox_button 'No Person', :unmatched, @search.unmatched?

#grid-filters data-turbo-cache="false"= render 'shared/grid_filters'
= render 'shared/record_grid', columns: @translator.column_def, filters_url: File.join(request.path.sub(%r{/(unhoused|unreviewed|unmatched)$}, ""), "advanced_search_filters.json")

.navbar.navbar-light.bg-light.navbar-expand-lg.navbar-static.bottom#search-pagination-bottom
  - count = @search.total_records
  .nav-item.mr-auto= "Found #{number_with_delimiter count} #{'record'.pluralize(count)}"
