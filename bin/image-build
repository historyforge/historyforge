#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
image="${1:-historyforge:local}"
revision=$(git rev-parse HEAD)
platform=${PLATFORM:-linux/amd64}
build=(docker buildx build --platform "$platform" --load
  --build-arg "REVISION=$revision" --tag "$image")

host_tools_available() {
  local tool
  for tool in ruby bundle node yarn rsync; do
    command -v "$tool" >/dev/null || return 1
  done
}

asset_mode=${PRECOMPILE_ASSETS:-auto}
if [ "$asset_mode" = auto ]; then
  asset_mode=docker
  if [ "$platform" = linux/amd64 ] &&
    [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] &&
    host_tools_available; then
    asset_mode=host
  fi
fi

if [ "$asset_mode" = host ]; then
  echo 'Precompiling assets on the host.' >&2
  staging=$(mktemp -d)
  trap 'rm -rf "$staging"' EXIT
  # Stage the checkout without local configuration or previously generated assets.
  git ls-files -z --cached --others --exclude-standard |
    rsync -a --from0 --files-from=- ./ "$staging/"
  (
    cd "$staging"
    cp lib/docker/database.yml config/database.yml
    mkdir -p log
    export BUNDLE_FROZEN=true
    bundle check || bundle install
    yarn install --immutable
    export RAILS_ENV=production
    yarn build
    SKIP_JS_BUILD=1 SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile
  )
  "${build[@]}" --build-context "compiled-assets=$staging/public/assets" "$staging"
else
  "${build[@]}" .
fi
