#!/usr/bin/env ruby
require 'fileutils'
require 'securerandom'

APP_ROOT = File.expand_path('..', __dir__)

def system!(*)
  system(*, exception: true)
end

FileUtils.chdir APP_ROOT do
  abort 'bin/setup is for development; unset RAILS_ENV or set it to development.' unless ENV.fetch('RAILS_ENV', 'development') == 'development'

  puts '== Installing Ruby dependencies =='
  bundler_version = File.read('Gemfile.lock').split("BUNDLED WITH\n").last.strip
  system! 'gem', 'install', 'bundler', '--version', bundler_version, '--no-document'
  system('bundle', 'check') || system!('bundle', 'install')

  puts '== Preparing local configuration (existing files are preserved) =='
  FileUtils.cp('config/database.example.yml', 'config/database.yml') unless File.exist?('config/database.yml')
  unless File.exist?('.env')
    env = File.read('.exampleenv')
    env = env.gsub('results-of-running-rake-secret') { SecureRandom.hex(64) }
    File.write('.env', env, perm: 0o600)
  end

  puts '== Installing and building JavaScript dependencies =='
  system! 'yarn', 'install', '--immutable'
  system! 'yarn', 'build'

  puts '== Preparing development and test databases =='
  system! 'bin/rails', 'db:prepare'
  system!({ 'RAILS_ENV' => 'test' }, 'bin/rails', 'db:prepare')

  puts 'Setup complete. Run bin/dev to start HistoryForge.'
end
