{
  "name": "HistoryForge",
  "dockerComposeFile": "docker-compose.yml",
  "service": "historyforge",
  "workspaceFolder": "/workspaces/historyforge",
  "postCreateCommand": "bin/setup",
  "forwardPorts": [
    3000
  ],
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp"
      ]
    }
  }
}
